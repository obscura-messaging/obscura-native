-- Every device this client can address: its own (user_id = the local user) and its peers'.
-- Keyed by (user_id, device_id) because a device list is a claim made about one user; a peer's
-- DEVICE_ANNOUNCE can never reassign a device that belongs to someone else.
CREATE TABLE IF NOT EXISTS Device (
    user_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    name TEXT NOT NULL DEFAULT '',
    PRIMARY KEY (user_id, device_id)
);

CREATE TABLE IF NOT EXISTS DeviceIdentity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    device_id TEXT NOT NULL
);

selectByUser:
SELECT * FROM Device WHERE user_id = ? ORDER BY device_id;

insert:
INSERT OR REPLACE INTO Device(user_id, device_id, name) VALUES (?, ?, ?);

deleteByUser:
DELETE FROM Device WHERE user_id = ?;

deleteAll:
DELETE FROM Device;

selectIdentity:
SELECT * FROM DeviceIdentity WHERE id = 1;

insertIdentity:
INSERT OR REPLACE INTO DeviceIdentity(id, device_id)
VALUES (1, ?);

deleteIdentity:
DELETE FROM DeviceIdentity WHERE id = 1;
