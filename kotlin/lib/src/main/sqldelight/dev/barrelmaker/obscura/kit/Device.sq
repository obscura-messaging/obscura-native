-- Every device this client can address, its own included, keyed per user.
CREATE TABLE IF NOT EXISTS Device (
    user_id TEXT NOT NULL,
    device_id TEXT NOT NULL,
    PRIMARY KEY (user_id, device_id)
);

-- This device. One row.
CREATE TABLE IF NOT EXISTS DeviceIdentity (
    id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
    device_id TEXT NOT NULL
);

selectByUser:
SELECT device_id FROM Device WHERE user_id = ? ORDER BY device_id;

insert:
INSERT OR IGNORE INTO Device(user_id, device_id) VALUES (?, ?);

deleteByUser:
DELETE FROM Device WHERE user_id = ?;

deleteAll:
DELETE FROM Device;

selectIdentity:
SELECT device_id FROM DeviceIdentity WHERE id = 1;

insertIdentity:
INSERT OR REPLACE INTO DeviceIdentity(id, device_id) VALUES (1, ?);

deleteIdentity:
DELETE FROM DeviceIdentity;
