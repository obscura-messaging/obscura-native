-- The app's opaque entry store. Read and written by `EntryStore.kt`.
CREATE TABLE IF NOT EXISTS ModelEntry (
    model_name TEXT NOT NULL,
    entry_id TEXT NOT NULL,
    data TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    author_device_id TEXT NOT NULL,
    local_metadata TEXT,
    PRIMARY KEY (model_name, entry_id)
);

selectByModel:
SELECT * FROM ModelEntry WHERE model_name = ?;

insertEntry:
INSERT OR REPLACE INTO ModelEntry(
    model_name, entry_id, data, timestamp, author_device_id, local_metadata
)
VALUES (?, ?, ?, ?, ?, ?);

deleteEntry:
DELETE FROM ModelEntry WHERE model_name = ? AND entry_id = ?;

deleteAllEntries:
DELETE FROM ModelEntry;
