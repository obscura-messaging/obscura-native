CREATE TABLE IF NOT EXISTS Friend (
    user_id TEXT NOT NULL PRIMARY KEY,
    username TEXT NOT NULL,
    status TEXT NOT NULL
);

selectAll:
SELECT user_id, username, status FROM Friend ORDER BY username, user_id;

selectById:
SELECT user_id, username, status FROM Friend WHERE user_id = ?;

insert:
INSERT OR REPLACE INTO Friend(user_id, username, status) VALUES (?, ?, ?);

updateStatus:
UPDATE Friend SET status = ? WHERE user_id = ?;

deleteById:
DELETE FROM Friend WHERE user_id = ?;

deleteAll:
DELETE FROM Friend;
